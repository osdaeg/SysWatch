# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
HOSTNAME_ALIAS=
CHECK_INTERVAL=300

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------

ENABLE_GOTIFY=true
GOTIFY_URL=http://192.168.88.100:8088
GOTIFY_TOKEN=

# Nivel mínimo que se dispara a Gotify: DEBUG, INFO, WARNING (default), ERROR/CRITICAL
NOTIFY_MIN_LEVEL=WARNING

# -----------------------------------------------------------------------------
# HTML
# -----------------------------------------------------------------------------

HTML_TITLE=SysWatch

# -----------------------------------------------------------------------------
# Thresholds
# -----------------------------------------------------------------------------

CPU_WARNING=80
CPU_CRITICAL=95
# Cuántas lecturas previas (además de la actual) deben también superar el
# umbral para que el status cambie de verdad -- evita que un pico puntual
# dispare WARNING/CRITICAL (y por lo tanto una notificación).
CPU_SUSTAINED_SAMPLES=3

RAM_WARNING=80
RAM_CRITICAL=95

DISK_WARNING=85
DISK_CRITICAL=95
DISK_SUSTAINED_SAMPLES=3
# Ignora mounts fuse.* (rclone, sshfs, etc.) por default
DISK_EXCLUDE_FUSE=true
# Mountpoints exactos a ignorar siempre, separados por coma
DISK_EXCLUDE_MOUNTS=/boot/efi

# sensors (lm-sensors) o thermal_zone (/sys/class/thermal, sin dependencias)
TEMP_SOURCE=sensors
TEMP_WARNING=75
TEMP_CRITICAL=90
TEMP_SUSTAINED_SAMPLES=3
# Substrings a ignorar (case-insensitive), separados por coma. Ej: SYSTIN,PCH
TEMP_EXCLUDE_SENSORS=

DOCKER_EXCLUDE_CONTAINERS=mariadb,mongo,pgsql,redis
DOCKER_STARTUP_GRACE_SECONDS=300

RCLONE_FSTYPE_PATTERN=fuse.rclone
RCLONE_TIMEOUT_SECONDS=5
RCLONE_SUSTAINED_SAMPLES=3

BACKREST_URL=http://localhost:9898
BACKREST_PLANS=PlanGDriveLocal,PlanOnedriveLocal,PlanLocal,PlanMegaLocal,PlanpCloudLocal
# Solo si tenés auth habilitada en backrest:
BACKREST_USER=
BACKREST_PASSWORD=
BACKREST_MAX_AGE_HOURS=36

WEATHER_LAT=-35.81081
WEATHER_LON=-61.89897
WEATHER_API_KEY=

WEATHER_TEMP_WARNING_HIGH=30
WEATHER_TEMP_CRITICAL_HIGH=35
WEATHER_TEMP_WARNING_LOW=5
WEATHER_TEMP_CRITICAL_LOW=0
WEATHER_WIND_WARNING_KMH=40
WEATHER_WIND_CRITICAL_KMH=60
WEATHER_RAIN_WARNING_MMH=10
WEATHER_RAIN_CRITICAL_MMH=30
WEATHER_LANG=es

CLAMAV_LOG=/home/daniel/docker/antivirus/clamav/log/scan_downloads.log

CONNECTIVITY_TARGET=1.1.1.1
CONNECTIVITY_PING_COUNT=3

GLUETUN_API_URL=http://localhost:8000
GLUETUN_API_KEY=

QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=

SPEEDTEST_INTERVAL_MINUTES=360