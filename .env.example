# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
HOSTNAME_ALIAS=
CHECK_INTERVAL=300

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------

ENABLE_GOTIFY=true
GOTIFY_URL=http://192.168.88.100:8088
GOTIFY_TOKEN=token

# Nivel mínimo que se dispara a Gotify: DEBUG, INFO, WARNING (default), ERROR/CRITICAL
NOTIFY_MIN_LEVEL=WARNING

REMOTES=HOGAR-PC-Linux,DANIEL-PC
# -----------------------------------------------------------------------------
# HTML
# -----------------------------------------------------------------------------

HTML_TITLE=SysWatch

# -----------------------------------------------------------------------------
# Thresholds
# -----------------------------------------------------------------------------

CPU_WARNING=80
CPU_CRITICAL=95
# Cuántas lecturas previas (además de la actual) deben también superar el
# umbral para que el status cambie de verdad -- evita que un pico puntual
# dispare WARNING/CRITICAL (y por lo tanto una notificación).
CPU_SUSTAINED_SAMPLES=3

RAM_WARNING=80
RAM_CRITICAL=95

DISK_WARNING=80
DISK_CRITICAL=95
DISK_SUSTAINED_SAMPLES=3
# Ignora mounts fuse.* (rclone, sshfs, etc.) por default
DISK_EXCLUDE_FUSE=true
# Mountpoints exactos a ignorar siempre, separados por coma
DISK_EXCLUDE_MOUNTS=/boot/efi

# sensors (lm-sensors) o thermal_zone (/sys/class/thermal, sin dependencias)
TEMP_SOURCE=sensors
TEMP_WARNING=75
TEMP_CRITICAL=90
TEMP_SUSTAINED_SAMPLES=3
# Substrings a ignorar (case-insensitive), separados por coma. Ej: SYSTIN,PCH
TEMP_EXCLUDE_SENSORS=

DOCKER_EXCLUDE_CONTAINERS=mariadb,mongo,pgsql,redis
DOCKER_STARTUP_GRACE_SECONDS=600

RCLONE_FSTYPE_PATTERN=fuse.rclone
RCLONE_TIMEOUT_SECONDS=5
RCLONE_SUSTAINED_SAMPLES=3
# docker/host
RCLONE_EXECUTABLE=docker
RCLONE_CONTAINER=rclone-webui
#RCLONE_REMOTE_OVERRIDE=GDrive:gdrive-personal,OtroMount:otroremote

BACKREST_URL=http://localhost:9898
BACKREST_PLANS=PlanGDriveLocal,PlanOnedriveLocal,PlanLocal,PlanMegaLocal,PlanpCloudLocal,PlanExtraibleLocal
# Solo si tenés auth habilitada en backrest:
BACKREST_USER=
BACKREST_PASSWORD=
BACKREST_MAX_AGE_HOURS=48

# Pehuajó
WEATHER_LAT=-35.81081
WEATHER_LON=-61.89897

#WEATHER_LAT=-34.57
#WEATHER_LON=-58.39

WEATHER_API_KEY=openweathermapapi

WEATHER_TEMP_WARNING_HIGH=30
WEATHER_TEMP_CRITICAL_HIGH=35
WEATHER_TEMP_WARNING_LOW=5
WEATHER_TEMP_CRITICAL_LOW=0
WEATHER_WIND_WARNING_KMH=40
WEATHER_WIND_CRITICAL_KMH=60
WEATHER_RAIN_WARNING_MMH=10
WEATHER_RAIN_CRITICAL_MMH=30
WEATHER_LANG=es

CLAMAV_LOG=/home/daniel/docker/antivirus/clamav/log/scan_downloads.log

CONNECTIVITY_TARGET=1.1.1.1
CONNECTIVITY_PING_COUNT=3

GLUETUN_API_URL=http://localhost:8000
GLUETUN_API_KEY=

QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=

SPEEDTEST_INTERVAL_MINUTES=360

DVR_URL=http://192.168.88.101
DVR_USER=admin
DVR_PASSWORD="dvrpassword"
DVR_API_PATH=PSIA
DVR_CAMERAS=101:Patio,201:Galeria,301:Terraza,401:Frente
DVR_KEEP_IMAGES=10
DVR_TIMEOUT_SECONDS=30
DVR_SUSTAINED_SAMPLES=3

OPENSKY_CLIENT_ID=openskyclientid
OPENSKY_CLIENT_SECRET=openskyclientsecret
OPENSKY_RADIUS_KM=40
AIRCRAFT_INFO_RADIUS_KM=5
AIRCRAFT_INFO_ALTITUDE_M=3000
AIRCRAFT_RADAR_LABEL=true

TRACESTRACK_API=tracestrackapi

# -----------------------------------------------------------------------------
# Certificates
# -----------------------------------------------------------------------------

CERT_WARNING_DAYS=30
CERT_CRITICAL_DAYS=7
#CERT_HOSTS="localhost:8443,example.com:443"
CERT_HOSTS=""

GITHUB_USER="githubuser"
CODEBERG_USER="codeberguser"
GITHUB_HOST="github.com"
CODEBERG_HOST="codeberg.org"
GITHUB_TOKEN="githubtoken"
CODEBERG_TOKEN="codebergtoken"
GITEA_USER=giteauser
GITEA_HOST="192.168.88.100:3000"
GITEA_TOKEN="giteatoken"
# Also use those variables (GITEA_...) if the server is Forgejo

SMN_ACTUAL_FILE=${CACHE_DIR}/actual.json
SMN_FORECAST_FILE=${CACHE_DIR}/forecast.json
SMN_ALERTS_FILE=${CACHE_DIR}/cap_alerts.json

SMN_MAX_AGE_MINUTES=90
SMN_FORECAST_DAYS=5

SMN_TEMP_WARNING_HIGH=30
SMN_TEMP_CRITICAL_HIGH=35
SMN_TEMP_WARNING_LOW=5
SMN_TEMP_CRITICAL_LOW=0
SMN_WIND_WARNING_KMH=40
SMN_WIND_CRITICAL_KMH=60

RSS_ARTICLES_TO_DISPLAY=8
RSS_SOURCES="https://www.infobae.com/arc/outboundfeeds/rss/","https://www.fabio.com.ar/rss.php,https://diarionoticiaspehuajo.com/rss"
RSS_PATTERNS_TO_IGNORE="infobae.com/mexico,infobae.com/espana,infobae.com/colombia,infobae.com/peru,infobae.com/panama,infobae.com/costa-rica,infobae.com/estados-unidos,infobae.com/guatemala,infobae.com/el-salvador,infobae.com/republica-dominicana,infobae.com/honduras,infobae.com/cuba,infobae.com/nicaragua"

GMAIL_USER=user@gmail.com
GMAIL_PASSWORD="abcdefghijklmnop"

OUTLOOK_USER="user@outlook.com"
OUTLOOK_PASSWORD="password"

JOURNAL_PRIORITY_FILTER="<=4"
JOURNAL_PATTERN_FILTER=false
JOURNAL_MESSAGE_FILTER="error|failed|failure|fail|cannot|could not|unable to|permission denied|denied|timed out|timeout|segmentation fault|segfault|core dump|dumped core|panic|critical|fatal|oom"